#!/bin/bash
# pre-push：课程静态化防漂移门禁 + 作业文件名串号闸（2026-10-31 升级版）
#
# 要防的两类病：
#   ① 漂移：mentors-den/course/*.md 改了，但 docs/course/*.html 没重建 → push 上去的站点
#      展示的是**旧课文**，而仓里的 md 已经是新的 → 源与产物不一致，且**没人会发现**
#      （老形态是 md→KV，publish 脚本会体检；新形态 md→HTML，产物要入 git，靠这个钩子）
#   ② 串号：课时正文里的作业文件名周号 ≠ 本课周号（学员会照抄成错名文件）
#
# ★ 2026-10-31 关键口径（三处收紧，均为冰爪 10-31 实测 + 我方复现）：
#   A. **判「被推的那一份」，不是判工作树当前状态** —— git push 传给本钩子的
#      $1/$2 是「远端名 + 远端 URL」，**不是被推的 ref** ⇒ 用 HEAD 作被推副本的代理
#      （已知边界：push 的分支若不是当前 HEAD，按 HEAD 判；本仓惯例 push 当前分支）。
#      效果：本地未提交的脏改动**不会**误伤这次 push，也不会被当进被推内容。
#   B. **覆盖缺口**：旧 glob 只认 W*.md / W*.html ⇒ 聚合文件全漏
#      （源侧 SYLLABUS.md、产物侧 syllabus.html + index.json）。
#      实测：往源 SYLLABUS.md 注入串号并重建产物 → 旧闸 rc=0、串号直进远端。
#      现在：源与产物两侧都扫全部课程文件；聚合文件按**所在周次分节**判定归属。
#   C. **失败语义**：读不到 / 扫 0 个文件 / diff 失败 一律 rc≠0 拒，不当「没变」放行。
#   D. **递归覆盖**（2026-10-31 冰爪红格）：扫描器改为**递归** ⇒ 嵌套讲义
#      （course/algopedia/*.md）不再游离于扫描范围外。
#   E. **悬空课时 ID**（同上）：课时改名后，正文/文件名里指向**已不存在**的课时 ID
#      会被抓出来 —— 作业文件名级 = 致命（rc=1，学员会存错文件名）；正文指针级 = 只报不改。
#
# 绕过（紧急情况）：git push --no-verify（需事后补跑 node mentors-den/scripts/build-course-html.js）
#
# 启用（每台机器一次，clone 不自带 hooks）：
#   cd ~/projects/sand-hollow && git config core.hooksPath .githooks && chmod +x .githooks/pre-push

set -u

# ── 0) 切到仓根 ──────────────────────────────────────────────
# 防御性：git 跑 push 钩子前会 chdir 回工作树根，但**手工调用**钩子时 cwd 可能不是仓根
# ⇒ 显式切一次，路径按仓根解释。切不到 ⇒ 直接拒（路径不确定 ≠ 可以放行）。
if ! cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null; then
  echo ""
  echo "🚫 pre-push 拒绝：定位不到仓根（git rev-parse --show-toplevel 失败）—— 路径不确定 ≠ 可以放行"
  exit 1
fi

# ── 1) 被推的那一份 = HEAD ───────────────────────────────────
# git push 传的 $1=远端名、$2=远端 URL，都不是被推的 ref ⇒ 只能用 HEAD 作代理。
# 已知边界：push 非当前 HEAD 分支时按 HEAD 判（错判窗口）；本仓惯例 push 当前分支。
PUSH_REF=HEAD
if ! git rev-parse --verify --quiet "${PUSH_REF}^{commit}" >/dev/null 2>&1; then
  echo "⚠️  pre-push：${PUSH_REF} 还不是一个可解析的 commit（仓库还没有任何提交？）→ 无可推内容，放行"
  exit 0
fi

# ── 2) 作业文件名串号闸（判被推的那一份；源 + 产物两扫）─────
# 判据 = 不变量「文件名引用的周号 = 本课自己的周」，与 scan-week-refs.py 同一套正则。
# 覆盖：课时文件（W12-S1.md / W12.html）按文件名周号判；聚合文件（SYLLABUS.md /
# syllabus.html / index.json）按**所在周次分节**判。
run_scan() {
  dir="$1"; label="$2"; show_list="${3:-yes}"
  out=$(python3 mentors-den/scripts/scan-week-refs.py --ref "$PUSH_REF" --dir "$dir" 2>&1)
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo ""
    if [ "$rc" -eq 2 ]; then
      echo "🚫 pre-push 拒绝：串号扫描器**读不到 / 扫 0 个文件**（rc=2）—— 没验到 ≠ 没问题，不放行（$label）"
    else
      echo "🚫 pre-push 拒绝：$label 存在作业文件名串号 / 悬空课时 ID"
    fi
    echo "$out"
    exit 1
  fi
  # 成功也要留痕：扫描器判「只报不改」的遗留清单（正文指针指向已不存在的课时 ID）
  # ⇒ 课时改名后不是「没人察觉」，而是每次 push 都有一份清单可追。
  # 遗留清单只印**源侧**那一份（产物侧是源侧的镜像，印两遍没意义）
  if [ "$show_list" = "yes" ]; then
    case "$out" in
      *"正文指针指向不存在的课时 ID"*)
        echo ""
        echo "📋 遗留清单（$label，不拦 push，但别装没看见 —— 改名后正文指针没跟着改）："
        printf '%s\n' "$out" | awk '/正文指针指向不存在的课时 ID/{f=1} /^✅/{f=0} f' ;;
    esac
  fi
}
run_scan mentors-den/course "真源（mentors-den/course）" yes
run_scan docs/course "产物（docs/course）" no

# ── 3) 漂移闸：重建**被推那一份**的源 → 与**被推那一份**的产物逐字节比 ──
# 同样只看 HEAD，不看工作树 ⇒ 本地脏改动不误伤本次 push。
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$TMP/src" "$TMP/prod"
if ! git archive "$PUSH_REF" mentors-den/course 2>/dev/null | tar -x -C "$TMP/src" 2>/dev/null; then
  echo ""
  echo "🚫 pre-push 拒绝：导不出被推那一份的课程源（git archive ${PUSH_REF} mentors-den/course）—— 读不到 ≠ 没变"
  exit 1
fi
if ! git archive "$PUSH_REF" docs/course 2>/dev/null | tar -x -C "$TMP/prod" 2>/dev/null; then
  echo ""
  echo "🚫 pre-push 拒绝：导不出被推那一份的课程产物（git archive ${PUSH_REF} docs/course）—— 读不到 ≠ 没变"
  exit 1
fi
if ! node mentors-den/scripts/build-course-html.js --course-dir "$TMP/src/mentors-den/course" --out-dir "$TMP/out" >/dev/null 2>&1; then
  echo ""
  echo "🚫 pre-push 拒绝：课程构建失败（build-course-html.js 非零退出）"
  echo "   先修构建错误再 push —— 构建挂了说明产物会是坏的"
  exit 1
fi
DIFF_OUT=$(diff -rq "$TMP/out" "$TMP/prod/docs/course" 2>&1)
if [ -n "$DIFF_OUT" ]; then
  echo ""
  echo "🚫 pre-push 拒绝：被推那一份的 docs/course 产物与 mentors-den/course 源不一致（防漂移）"
  echo "$DIFF_OUT" | sed 's/^/     /'
  echo ""
  echo "   修法："
  echo "     node mentors-den/scripts/build-course-html.js"
  echo "     git add docs/course/ && git commit -m 'chore(course): 重建静态课程产物'"
  echo "   （产物要入 git —— GitHub Pages 靠仓库里的 HTML 直接发布，不在服务器上构建）"
  exit 1
fi

echo "✅ 被推那一份（${PUSH_REF}）：串号 0 处 + 产物与源一致"
exit 0
